# ---------------------------------------------------------------
# Dipendenze (si ricostruiscono con composer install / npm install)
# ---------------------------------------------------------------
/node_modules
/vendor

# ---------------------------------------------------------------
# Segreti e dati personali: NON devono MAI finire nel repository
# ---------------------------------------------------------------
.env
.env.*
!.env.example
auth.json

# database locale: contiene gli account di prova (email vere di chi collauda)
/database/*.sqlite
/database/*.sqlite-journal

# i log contengono i link di accesso monouso e gli indirizzi email
/storage/logs/*
!/storage/logs/.gitignore

# sessione salvata dai test end-to-end (cookie di un account reale).
# La regola è volutamente larga: se un percorso sbaglia cartella, il file
# resta comunque fuori dal repository.
**/.auth/

# L'ESAME VERO non entra nel repository: se le risposte si possono leggere,
# l'attestato non misura più niente. Nel repository resta solo la banca
# d'esempio; queste due si generano con `npm run exam:sync` e si caricano
# a mano sul server.
/dati/banca-esame-riservata.js
/Modules/Certificates/config/domande-riservate.php

# archivio vettoriale del tutor: si rigenera con `php artisan chat:ingest`
/storage/app/rag

# ---------------------------------------------------------------
# Cache e artefatti
# ---------------------------------------------------------------
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/pail
/bootstrap/cache/*.php
.phpunit.result.cache
/.phpunit.cache
/public_html/hot
/public_html/storage

# risultati dei collaudi
/test-results
/tests/report
/coverage
npm-debug.log
yarn-error.log

# ---------------------------------------------------------------
# Editor e sistema operativo
# ---------------------------------------------------------------
/.idea
/.vscode
/.fleet
/.zed
.DS_Store
Thumbs.db

# copia statica per l'anteprima su GitHub Pages
/_anteprima

# rapporto dell'audit di giocabilità
/tests/giocabilita.json
/tests/testi-canvas.json

# copia locale di QuantumSim usata dalla verifica incrociata (non è nostro codice)
/.quantumsim

# Configurazioni di comodo per la propria macchina (per esempio un percorso
# diverso del browser di Playwright): utili in locale, mai da versionare.
/playwright.config.local.js
